{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Mobile",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "production",
        "--target",
        "lib/main.dart"
      ]
    },
    {
      "name": "Launch Web",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--web-hostname",
        "localhost",
        "--target",
        "lib/main.dart"
      ]
    }
  ]
}