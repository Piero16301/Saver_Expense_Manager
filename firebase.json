{
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "appId": "1:269318126118:android:09311aaa03c92bdcfb04e7",
                    "fileOutput": "android/app/google-services.json",
                    "projectId": "saver-expense-manager"
                }
            },
            "dart": {
                "lib/firebase_options.dart": {
                    "configurations": {
                        "android": "1:269318126118:android:09311aaa03c92bdcfb04e7",
                        "ios": "1:269318126118:ios:e540158656abbe49fb04e7",
                        "web": "1:269318126118:web:4964b9f4a91d3e03fb04e7"
                    },
                    "projectId": "saver-expense-manager"
                }
            },
            "ios": {
                "default": {
                    "appId": "1:269318126118:ios:e540158656abbe49fb04e7",
                    "fileOutput": "ios/Runner/GoogleService-Info.plist",
                    "projectId": "saver-expense-manager",
                    "uploadDebugSymbols": true
                }
            }
        }
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                ".env"
            ]
        }
    ],
    "firestore": {
        "rules": "firestore.rules"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "hosting": {
        "public": "build/web",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "headers": [
            {
                "source": "/**",
                "headers": [
                    {
                        "key": "X-Frame-Options",
                        "value": "DENY"
                    },
                    {
                        "key": "X-Content-Type-Options",
                        "value": "nosniff"
                    },
                    {
                        "key": "Referrer-Policy",
                        "value": "strict-origin-when-cross-origin"
                    },
                    {
                        "key": "Permissions-Policy",
                        "value": "camera=(), microphone=(), geolocation=()"
                    }
                ]
            }
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}